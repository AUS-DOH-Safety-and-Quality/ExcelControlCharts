{
  "name": "office-addin-taskpane",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "excel",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3100
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:portable": "bun run ./scripts/build-portable.ts",
    "dev-server": "webpack serve --mode development",
    "lint": "bun x eslint src scripts",
    "lint:fix": "bun x eslint src scripts --fix",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "core-js": "^3.50.0",
    "d3-axis": "^3.0.0",
    "d3-drag": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/office-js": "^1.0.605",
    "@types/office-runtime": "^1.0.40",
    "@typescript-eslint/parser": "^8.67.0",
    "adm-zip": "^0.6.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-office-addins": "^4.0.10",
    "file-loader": "^6.2.0",
    "globals": "^17.11.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "office-addin-prettier-config": "^2.0.5",
    "os-browserify": "^0.3.0",
    "powerbi-visuals-api": "~5.1.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "6.0.0"
  },
  "overrides": {
    "tar": "^7.5.16",
    "js-yaml": "^4.3.1",
    "@hono/node-server": "^1.19.15",
    "hono": "^4.12.34",
    "ip-address": "^10.3.1",
    "form-data": "^4.0.6",
    "fast-uri": "^3.1.5",
    "axios": "^1.18.0",
    "shell-quote": "^1.10.0",
    "adm-zip": "^0.6.0",
    "brace-expansion": "^1.1.18",
    "body-parser": "^2.3.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}
